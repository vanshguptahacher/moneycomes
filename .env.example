# ==============================================================================
# MoneyComes Environment Variables — Safe Development Baseline
# DO NOT commit actual secrets or production credentials to source control.
#
# Production Architecture Baseline (Locked):
#   Expo Android App -> Cloudflare Workers -> Hono API -> Drizzle ORM -> Supabase PostgreSQL
#   Hono API -> Supabase Storage (attachments)
#   Hono API -> Better Auth (single authentication system, backed by PostgreSQL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Mobile App Only)
# Classification: CLIENT-SAFE
# Accessible to Expo / React Native client bundle via EXPO_PUBLIC_* prefix.
#
# RULES:
# - Mobile client MUST NEVER connect directly to PostgreSQL.
# - Mobile client MUST NEVER contain database passwords or Supabase service_role keys.
# - Mobile client reaches all backend resources exclusively via the Hono API over HTTPS.
# ------------------------------------------------------------------------------
# Development: Android Emulator loopback is 10.0.2.2. For physical LAN devices, use local IP (e.g., http://192.168.1.X:3000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Production: Points to the deployed Cloudflare Workers API URL (e.g., https://api.moneycomes.app)
# EXPO_PUBLIC_API_URL=https://api.moneycomes.app

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Development / Local Node Runtime)
# Classification: OPTIONAL (Defaults provided in server/config/index.ts)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. CORS & ORIGIN SECURITY
# Classification: REQUIRED in production, OPTIONAL in development
# Note: Wildcard (*) is strictly REJECTED in production when credentials are true.
# In development, provides explicit origins for Web & Expo dev server.
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,exp://localhost:8081
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (Supabase PostgreSQL — Server-Only)
# Classification: SECRET / SERVER-ONLY
#
# Development: Defaults to local PostgreSQL (Docker Compose or local install).
# Production: Points to Supabase PostgreSQL. Localhost is strictly REJECTED in production.
# ------------------------------------------------------------------------------
# Local Development Default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moneycomes

# Production (Supabase PostgreSQL via Transaction Pooler — port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Production (Supabase PostgreSQL Direct — port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Docker Compose Local Infrastructure (Development-Only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moneycomes

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION CONFIGURATION (Better Auth — Server-Only)
# Classification: SECRET / SERVER-ONLY
#
# ARCHITECTURAL RULE:
# Better Auth is the application's sole authentication system, persisted in PostgreSQL.
# Do NOT introduce Supabase Auth.
#
# BETTER_AUTH_SECRET: Cryptographically random string (min 32 chars).
# In production, default development placeholders are strictly REJECTED.
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=your_development_secret_here_minimum_32_characters
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. ATTACHMENT & OBJECT STORAGE CONFIGURATION (Supabase Storage — Server-Only)
# Classification: SECRET / SERVER-ONLY
#
# RULES:
# - Used server-side by Hono API to store and retrieve expense receipts/invoices.
# - SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and MUST NEVER be exposed
#   to the mobile application or prefixed with EXPO_PUBLIC_.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder
SUPABASE_STORAGE_BUCKET=attachments

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE WORKERS DEPLOYMENT REFERENCE
# Classification: DEPLOYMENT-ONLY
#
# For production deployment on Cloudflare Workers, environment secrets are injected
# via the Cloudflare dashboard or Wrangler secrets, NEVER committed to source control:
#   npx wrangler secret put DATABASE_URL
#   npx wrangler secret put BETTER_AUTH_SECRET
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# ------------------------------------------------------------------------------
