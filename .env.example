# ==============================================================================
# MoneyComes Environment Variables — Safe Development Baseline
# DO NOT commit actual secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Mobile App Only)
# Classification: CLIENT-SAFE
# Accessible to Expo / React Native client bundle via EXPO_PUBLIC_* prefix.
# ------------------------------------------------------------------------------
# Android Emulator loopback is 10.0.2.2. For physical LAN devices, use local IP (e.g., http://192.168.1.X:3000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# Classification: OPTIONAL (Defaults provided in server/config/index.ts)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. CORS & ORIGIN SECURITY
# Classification: REQUIRED in production, OPTIONAL in development
# Note: Wildcard (*) is strictly REJECTED in production when credentials are true.
# In development, provides explicit origins for Web & Expo dev server.
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,exp://localhost:8081
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (Server-Only)
# Classification: SECRET / SERVER-ONLY
# In production, this MUST point to a remote managed PostgreSQL database.
# Localhost and default credentials are REJECTED in production mode.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moneycomes

# Docker Compose Local Infrastructure (Development-Only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moneycomes

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION CONFIGURATION (Better Auth — Server-Only)
# Classification: SECRET / SERVER-ONLY
# BETTER_AUTH_SECRET: Cryptographically random string (min 32 chars).
# In production, default development placeholders are strictly REJECTED.
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=your_development_secret_here_minimum_32_characters
BETTER_AUTH_URL=http://localhost:3000
